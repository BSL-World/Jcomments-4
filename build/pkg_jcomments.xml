<?xml version="1.0" encoding="UTF-8"?>
<extension type="package" method="upgrade">
	<name>JComments Joomla 6 Patch Build</name>
	<author>JComments team</author>
	<creationDate>July 2026</creationDate>
	<packagename>jcomments</packagename>
	<version>5.0.0-bsl.1</version>
	<url>https://github.com/exstreme/Jcomments-4</url>
	<packager>Vasiliev Alexander, BSL-World</packager>
	<packagerurl>https://github.com/BSL-World/Jcomments-4</packagerurl>
	<description>Unofficial Joomla 6 compatibility patch build based on JComments 5.0.0 Beta by exstreme. Additional fixes and testing by Vasiliev Alexander, BSL-World.</description>

	<scriptfile>pkg_jcomments.php</scriptfile>
	<files folder="packages">
		<file type="component" id="com_jcomments">com_jcomments.zip</file>
		<file type="plugin" id="jcomments" group="content">plg_content_jcomments.zip</file>
		<file type="plugin" id="jcommentslock" group="editors-xtd">plg_jcommentslock_jcomments.zip</file>
		<file type="plugin" id="jcommentson" group="editors-xtd">plg_jcommentson_jcomments.zip</file>
		<file type="plugin" id="jcommentsoff" group="editors-xtd">plg_jcommentsoff_jcomments.zip</file>
		<file type="plugin" id="jcomments" group="finder">plg_finder_jcomments.zip</file>
		<file type="plugin" id="jcomments" group="system">plg_system_jcomments.zip</file>
		<file type="plugin" id="jcomments" group="user">plg_user_jcomments.zip</file>
		<file type="plugin" id="jcomments" group="quickicon">plg_quickicon_jcomments.zip</file>
	</files>

	<compatibility>
		<version>6</version>
	</compatibility>

	<blockChildUninstall>true</blockChildUninstall>
</extension>
